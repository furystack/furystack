{
  "name": "@furystack/task-runner-client",
  "version": "1.0.0",
  "description": "Browser-side SDK for the FuryStack distributed task runner",
  "type": "module",
  "scripts": {
    "build": "tsc --outDir ./esm"
  },
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    }
  },
  "files": [
    "esm",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/furystack/furystack.git"
  },
  "keywords": [
    "FuryStack",
    "task-runner",
    "client",
    "job-queue",
    "WebSocket"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Gallay Lajos <gallay.lajos@gmail.com>",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/furystack/furystack/issues"
  },
  "homepage": "https://github.com/furystack/furystack",
  "dependencies": {
    "@furystack/blob-store": "workspace:^",
    "@furystack/inject": "workspace:^",
    "@furystack/task-runner": "workspace:^",
    "@furystack/utils": "workspace:^"
  },
  "devDependencies": {
    "@furystack/core": "workspace:^",
    "@furystack/rest-service": "workspace:^",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
